# --- Application Config ---
PROJECT_NAME=GradeFlow API
API_V1_PREFIX=/api/v1
DEBUG=True

# --- MySQL Database Config ---
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=gradeflow_db
MYSQL_USER=gradeflow_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_ROOT_PASSWORD=your_mysql_root_password

# --- Database URL for SQLAlchemy ---
DATABASE_URL=mysql+pymysql://gradeflow_user:your_mysql_password@db:3306/gradeflow_db